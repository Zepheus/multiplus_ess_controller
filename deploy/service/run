#!/bin/sh
# venus-ess daemontools service.
# Lives in /data/venus-ess/service; /data/rc.local copies it to /run/service
# (tmpfs) each boot so supervise state and logs never touch eMMC flash.
exec 2>&1

# --- ACTIVE: shadow stage (READ-ONLY validation; replicates stock, leak included)
echo "*** starting venus-ess (stage: shadow) ***"
exec /data/venus-ess/venus-ess-controller --stage shadow --controller stock --quiet \
     --telemetry /run/venus-ess-stock.csv --telemetry-max-mb 4

# --- PROMOTION (comment the exec above, uncomment ONE below; svc -t to apply) ---
# The import-gap fix lives in the CONTROLLER flag, not the stage: "stock" replicates
# the leak by design; "adaptive" (PI + learned feed-forward) closes it.
#
# Step 1 — first supervised take-over: integral fixes the steady leak, the
# feed-forward model only LEARNS (does not act) so you can sanity-check it:
# export VENUS_ESS_LIVE=I_UNDERSTAND
