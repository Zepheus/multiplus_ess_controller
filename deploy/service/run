#      --controller adaptive --ff-learn-only --quiet \
#      --telemetry /run/venus-ess.csv --telemetry-max-mb 4
#
# Step 2 — full fix active (feed-forward acts once confident):
# export VENUS_ESS_LIVE=I_UNDERSTAND
# echo "*** starting venus-ess (stage: TAKEOVER, adaptive) ***"
# exec /data/venus-ess/venus-ess-controller --stage takeover --confirm \
#      --controller adaptive --quiet \
